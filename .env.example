# Copy to .env and fill in. This example file carries no real values,
# so it is safe to share or commit.
#
# Find these in Supabase -> Project Settings -> API.

# Public — safe in the browser, guarded by Row Level Security
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...replace-me

# Private — server side only, never in front-end code
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only-never-in-the-browser
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=replace-me

# Where JUDECH data goes
SUPABASE_PAYMENTS_TABLE=payments
SUPABASE_AGREEMENTS_TABLE=agreements
SUPABASE_PROJECTS_TABLE=projects
SUPABASE_RECEIPTS_BUCKET=receipts
SUPABASE_SIGNATURES_BUCKET=signatures
